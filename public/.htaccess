Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /perfect-pvc/

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml model/gltf-binary
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml model/gltf-binary
  </IfModule>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType model/gltf-binary .glb
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|jpg|png|svg|ico|glb)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
